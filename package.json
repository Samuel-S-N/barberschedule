    "export:web": "expo export --platform web",
    "e2e:export": "EXPO_NO_DOTENV=1 EXPO_PUBLIC_SUPABASE_URL=https://example.supabase.co EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=test-publishable-key expo export --platform web --output-dir .e2e-dist",
    "e2e:serve": "node scripts/serve-web-static.mjs .e2e-dist 4173",
    "verify": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run test:e2e:runner && npm run test:db"
