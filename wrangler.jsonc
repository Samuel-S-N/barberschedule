{
  // Dev Worker (workers.dev, behind Cloudflare Access). Plan 2 adds env.production: zenc-web on zencpro.app and *.zencpro.app.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zenc-web-dev",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" }
}
