# Local environment for `npx supabase functions serve --env-file supabase/functions/.env.local` (copy this file to .env.local, which git ignores).
# Where an invite e-mail sends the invited person: the business's own address. Without it the redirect falls back to the auth site_url
# (http://127.0.0.1:3000), which is not where the app runs.
SHOP_URL_TEMPLATE=http://{slug}.localhost:8081
# dispatch-notifications (push and the reminder e-mail): leave RESEND_API_KEY empty to skip e-mails and only log them.
RESEND_API_KEY=
EMAIL_FROM=
